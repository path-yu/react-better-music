{
  "name": "react-music",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 5173",
    "dev:api": "node server/app.js",
    "typecheck": "tsc --noEmit",
    "typecheck:desktop": "tsc --noEmit -p tsconfig.bun.json",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && vite build",
    "build:electrobun": "tsc --noEmit && node scripts/prepare-electrobun-api.mjs && vite build --mode electrobun",
    "desktop:dev": "hutch run dev",
    "desktop:build": "hutch run build",
    "desktop:installer": "node scripts/installer/build.mjs",
    "desktop:release": "pnpm desktop:build && pnpm desktop:installer",
    "dev:tauri": "vite dev --mode tauri --port 5173 --strictPort",
    "build:tauri": "tsc --noEmit && vite build --mode tauri",
    "tauri:dev": "node scripts/tauri-cli.mjs dev",
    "tauri:build": "node scripts/tauri-cli.mjs build --no-bundle",
    "tauri:installer": "node scripts/tauri-cli.mjs build",
    "generate-routes": "tsr generate",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lingui/core": "6.10.1",
    "@lingui/react": "6.10.1",
    "@pikoloo/darwin-ui": "^2.1.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-virtual": "^3.14.22",
    "@videojs/react": "10.2.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.61.0",
    "mediabunny": "^1.62.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@eslint/js": "^10.0.1",
    "@lingui/babel-plugin-lingui-macro": "6.10.1",
    "@lingui/cli": "6.10.1",
    "@lingui/vite-plugin": "6.10.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-plugin": "1.168.48",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}