{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "声屿",
  "version": "0.1.0",
  "identifier": "com.qimiao.music",
  "build": {
    "beforeDevCommand": "pnpm dev:tauri",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build:tauri",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [
      {
        "title": "声屿",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
